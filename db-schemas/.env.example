# App Configuration
APP_NAME=Gram Panchayat API
APP_VERSION=1.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://gp_admin:your_password@localhost:5432/gram_panchayat_db
DB_ECHO=False

# Security
SECRET_KEY=your-secret-key-change-in-production-use-60-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100
